{
  "manifest_version": 3,
  "name": "Google Home Camera Resizer",
  "version": "1.0.0",
  "description": "Resize camera tiles on the Google Home cameras page, with an on/off switch to restore the default layout.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://home.google.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
